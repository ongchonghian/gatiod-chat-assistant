{
  "policy_version": "0.1.0",
  "default_state": "COLLECTING_FACTS",
  "global_rules": [
    "Ask the smallest next necessary question.",
    "Extract and confirm facts before calculation.",
    "Never render final PI% unless the assess_* tool succeeds.",
    "Keep internal IDs out of user-facing messages.",
    "When user corrects facts, patch the structured state and reconfirm."
  ],
  "system_key": "upper_limb",
  "title": "Upper Limb",
  "chapter": 3,
  "calculation_tool": "assess_upper_limb",
  "lookup_tools": [
    "lookup_rom_table",
    "lookup_amputation_level",
    "lookup_nerve",
    "lookup_dbe_condition",
    "search_dictionary"
  ],
  "activation_terms": [
    "shoulder",
    "arm",
    "elbow",
    "wrist",
    "hand",
    "thumb",
    "finger",
    "brachial plexus",
    "median nerve",
    "ulnar nerve",
    "radial nerve",
    "suprascapular"
  ],
  "assessment_paths": [
    {
      "key": "amputation",
      "label": "Amputation",
      "finding_required": "amputation level"
    },
    {
      "key": "rom",
      "label": "Restricted motion or ankylosis",
      "finding_required": "joint, direction, angle, ankylosis flag"
    },
    {
      "key": "neurological",
      "label": "Nerve deficit",
      "finding_required": "nerve, deficit type, loss type"
    },
    {
      "key": "dbe",
      "label": "Diagnosis-based estimate",
      "finding_required": "condition row and selected percent"
    }
  ],
  "slots": [
    {
      "key": "side",
      "required_when": "always",
      "question": "Which upper limb is affected — left or right?",
      "chips": [
        "Left",
        "Right"
      ]
    },
    {
      "key": "finding_type",
      "required_when": "no_assessable_finding_detected",
      "question": "What type of upper-limb finding should I assess: amputation, ROM restriction, nerve deficit, diagnosis-based injury, or a combination?",
      "chips": [
        "ROM restriction",
        "Nerve deficit",
        "DBE injury",
        "Amputation"
      ]
    },
    {
      "key": "rom_joint",
      "required_when": "rom_present AND joint_missing",
      "question": "Which joint is the ROM finding for — shoulder, elbow, wrist, thumb, or finger?",
      "chips": [
        "Shoulder",
        "Elbow",
        "Wrist",
        "Finger"
      ]
    },
    {
      "key": "rom_measurements",
      "required_when": "rom_present AND measurements_missing",
      "question": "What ROM direction and angle should I record? For example: shoulder flexion 90°, abduction 90°.",
      "chips": [
        "Flexion 90°",
        "Abduction 90°",
        "Add multiple ROM values"
      ]
    },
    {
      "key": "ankylosis_flag",
      "required_when": "rom_present AND fixed_position_unclear",
      "question": "Is the joint ankylosed/fixed, or is this restricted active motion?",
      "chips": [
        "Restricted motion",
        "Ankylosed/fixed"
      ]
    },
    {
      "key": "nerve_details",
      "required_when": "neurological_present AND nerve_or_deficit_missing",
      "question": "Which nerve is affected, and is the deficit sensory, motor, or combined? Is it total or partial?",
      "chips": [
        "Sensory partial",
        "Motor total",
        "Combined partial"
      ]
    },
    {
      "key": "rom_from_nerve",
      "required_when": "rom_present AND neurological_present",
      "question": "Are the ROM restrictions due to the nerve lesion, or are they independent ROM findings?",
      "chips": [
        "Independent ROM",
        "Due to nerve lesion"
      ]
    },
    {
      "key": "dbe_condition",
      "required_when": "dbe_present AND condition_unclear",
      "question": "Which diagnosis-based condition or GATIOD row should I use?",
      "chips": [
        "Fracture",
        "Instability",
        "Osteoarthritis",
        "Tenosynovitis"
      ]
    },
    {
      "key": "confirmation",
      "required_when": "ready_to_calculate",
      "question": "Please confirm the extracted upper-limb findings before I calculate the system-generated PI%.",
      "chips": [
        "Confirm and calculate",
        "Edit findings"
      ]
    }
  ],
  "conversation_rules": [
    {
      "id": "UL_ROM_ADD",
      "rule": "Same-joint restricted ROM directions are added."
    },
    {
      "id": "UL_ANKYLOSIS_MAX",
      "rule": "Same-joint ankylosis directions use the single largest value."
    },
    {
      "id": "UL_ROM_NERVE_GATE",
      "rule": "If ROM is due to nerve lesion, exclude ROM to prevent double compensation."
    },
    {
      "id": "UL_DBE_ROM_CONFLICT",
      "rule": "If DBE and ROM apply to same joint/condition, use the higher valid path unless explicit combination is allowed."
    },
    {
      "id": "UL_AMPUTATION_SUPPRESSION",
      "rule": "Proximal amputation suppresses distal structures."
    },
    {
      "id": "UL_CAP",
      "rule": "Upper limb final PI is capped at 75%."
    }
  ],
  "confirmation_sections": [
    "side",
    "amputations",
    "rom",
    "neurological",
    "rom_from_nerve",
    "dbe"
  ],
  "post_result_actions": [
    "Adjust findings",
    "Add another system",
    "Record doctor PI%",
    "Export report"
  ]
}
