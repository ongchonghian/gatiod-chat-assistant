{
  "policy_version": "0.1.0",
  "default_state": "COLLECTING_FACTS",
  "global_rules": [
    "Ask the smallest next necessary question.",
    "Extract and confirm facts before calculation.",
    "Never render final PI% unless the assess_* tool succeeds.",
    "Keep internal IDs out of user-facing messages.",
    "When user corrects facts, patch the structured state and reconfirm."
  ],
  "system_key": "lower_limb",
  "title": "Lower Limb",
  "chapter": 4,
  "calculation_tool": "assess_lower_limb",
  "lookup_tools": [
    "lookup_lower_amputation",
    "lookup_lower_nerve",
    "lookup_shortening",
    "lookup_lower_dbe_condition",
    "lookup_rom_table"
  ],
  "activation_terms": [
    "pelvis",
    "hip",
    "knee",
    "ankle",
    "foot",
    "toe",
    "leg",
    "femur",
    "tibia",
    "acl",
    "pcl",
    "meniscus",
    "sciatic",
    "peroneal"
  ],
  "assessment_paths": [
    {
      "key": "amputation",
      "label": "Leg or toe amputation",
      "finding_required": "legLevel or toe level"
    },
    {
      "key": "rom",
      "label": "Restricted motion or ankylosis",
      "finding_required": "joint, direction, angle, ankylosis flag"
    },
    {
      "key": "neurological",
      "label": "Nerve deficit",
      "finding_required": "nerve, deficit type, loss type"
    },
    {
      "key": "shortening",
      "label": "Measured limb length discrepancy",
      "finding_required": "discrepancyCm"
    },
    {
      "key": "dbe",
      "label": "Diagnosis-based estimate",
      "finding_required": "condition row and selected percent"
    }
  ],
  "slots": [
    {
      "key": "side",
      "required_when": "always",
      "question": "Which lower limb is affected — left or right?",
      "chips": [
        "Left",
        "Right"
      ]
    },
    {
      "key": "finding_type",
      "required_when": "no_assessable_finding_detected",
      "question": "What lower-limb finding should I assess: amputation, ROM restriction, nerve deficit, limb shortening, diagnosis-based injury, or a combination?",
      "chips": [
        "ROM restriction",
        "DBE injury",
        "Amputation",
        "Shortening"
      ]
    },
    {
      "key": "toe_vs_shortening_gate",
      "required_when": "toe_amputation_or_shortening_ambiguous",
      "question": "Is this a toe/foot amputation, or a measured leg-length discrepancy in centimetres?",
      "chips": [
        "Toe/foot amputation",
        "Leg-length discrepancy"
      ]
    },
    {
      "key": "rom_joint",
      "required_when": "rom_present AND joint_missing",
      "question": "Which joint is the ROM finding for — hip, knee, ankle, subtalar, or toe?",
      "chips": [
        "Hip",
        "Knee",
        "Ankle",
        "Great toe"
      ]
    },
    {
      "key": "rom_measurements",
      "required_when": "rom_present AND measurements_missing",
      "question": "What ROM direction and angle should I record?",
      "chips": [
        "Knee flexion",
        "Hip flexion",
        "Ankle dorsiflexion"
      ]
    },
    {
      "key": "nerve_details",
      "required_when": "neurological_present AND nerve_or_deficit_missing",
      "question": "Which lower-limb nerve is affected, and is the deficit sensory, motor, or combined? Is it total or partial?",
      "chips": [
        "Sciatic",
        "Common peroneal",
        "Femoral",
        "Tibial"
      ]
    },
    {
      "key": "rom_from_nerve",
      "required_when": "rom_present AND neurological_present",
      "question": "Are the ROM restrictions due to the nerve lesion, or are they independent ROM findings?",
      "chips": [
        "Independent ROM",
        "Due to nerve lesion"
      ]
    },
    {
      "key": "shortening_cm",
      "required_when": "shortening_present AND discrepancyCm_missing",
      "question": "What is the measured limb length discrepancy in centimetres?",
      "chips": [
        "1 cm",
        "2 cm",
        "3 cm",
        "No shortening"
      ]
    },
    {
      "key": "confirmation",
      "required_when": "ready_to_calculate",
      "question": "Please confirm the extracted lower-limb findings before I calculate the system-generated PI%.",
      "chips": [
        "Confirm and calculate",
        "Edit findings"
      ]
    }
  ],
  "conversation_rules": [
    {
      "id": "LL_TOE_NOT_SHORTENING",
      "rule": "Toe/foot amputations must be captured under amputations, never shortening."
    },
    {
      "id": "LL_ROM_NERVE_GATE",
      "rule": "If ROM is due to nerve lesion, exclude ROM to prevent double compensation."
    },
    {
      "id": "LL_DBE_ROM_CONFLICT",
      "rule": "If DBE and ROM apply to the same joint/condition, use the higher valid path unless explicit combination is allowed."
    },
    {
      "id": "LL_AMPUTATION_SUPPRESSION",
      "rule": "Leg-level amputation suppresses distal toe findings."
    }
  ],
  "confirmation_sections": [
    "side",
    "amputations",
    "rom",
    "neurological",
    "rom_from_nerve",
    "shortening",
    "dbe"
  ],
  "post_result_actions": [
    "Adjust findings",
    "Add another system",
    "Record doctor PI%",
    "Export report"
  ]
}
