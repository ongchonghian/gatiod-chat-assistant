{
  "name": "gatiod-chat-assistant",
  "version": "0.1.0",
  "description": "GATIOD assessment chat assistant — conversational front-end to AcuScore calculation engine",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run tests/engine",
    "lint": "tsc --noEmit",
    "build:excel-fixtures": "tsx scripts/build-excel-fixtures.ts",
    "check:excel-fixtures-fresh": "tsx scripts/check-excel-fixtures-fresh.ts",
    "check:adr-0001-promotion": "tsx scripts/check-adr-0001-promotion.ts",
    "docs:verify": "tsx scripts/docs-verify.ts",
    "test:excel-shadow": "GATIOD_RUN_EXCEL_SCENARIOS=true vitest run tests/v2/excelScenarios",
    "test:excel-full": "GATIOD_RUN_EXCEL_SCENARIOS=true EXCEL_SCENARIO_FULL=true vitest run --testTimeout=900000 tests/v2/excelScenarios",
    "test:semantic-shadow": "GATIOD_RUN_SEMANTIC_SHADOW=true vitest run --testTimeout=600000 tests/v2/semanticShadow",
    "calibration:run": "tsx scripts/calibration/run.ts",
    "calibration:run:full": "tsx scripts/calibration/run.ts --full",
    "calibration:check": "tsx scripts/calibration/run.ts --check"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^3.2.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
